---
import { profileData } from "../data/profile";
import { siteConfig } from "../data/config";
import ProfilePhoto from "./ProfilePhoto.astro";
---

<section id="home" class="relative pt-10 pb-16 md:pt-16 md:pb-24 overflow-hidden">
  <!-- Subtle ambient background radial gradients -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-b from-sky-500/10 via-cyan-500/5 to-transparent blur-3xl pointer-events-none -z-10"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Text Column (Col 7/12) -->
      <div class="lg:col-span-7 flex flex-col items-start space-y-5">
        
        <!-- Status / Location Badge -->
        <div class="inline-flex flex-wrap items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900/90 border border-slate-700/70 text-xs text-slate-300 shadow-sm">
          <span class="flex h-2 w-2 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="font-medium text-slate-200">{profileData.location}</span>
          <span class="text-slate-500">•</span>
          <span class="text-sky-400 font-medium">{profileData.workPreference}</span>
        </div>

        <!-- Main Title & Name -->
        <div class="space-y-2">
          <p class="text-xs sm:text-sm uppercase font-mono tracking-widest text-sky-400 font-semibold">
            Cybersecurity Professional
          </p>
          <h1 class="text-4xl sm:text-5xl xl:text-6xl font-extrabold text-slate-100 tracking-tight leading-tight">
            {profileData.name}
          </h1>
          <p class="text-xl sm:text-2xl font-semibold text-slate-300 leading-snug pt-1">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 via-cyan-300 to-blue-400">
              {profileData.primaryHeadline}
            </span>
          </p>
        </div>

        <!-- Supporting Paragraph -->
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
          {profileData.supportingHeadline}
        </p>

        <!-- Technical Telemetry Highlight Box -->
        <div class="w-full p-4 rounded-xl bg-slate-900/80 border border-slate-800/90 text-sm text-slate-300 space-y-1.5 shadow-sm">
          <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-sky-400 font-semibold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Core Tooling & Operations</span>
          </div>
          <p class="text-slate-300 leading-relaxed text-xs sm:text-sm">
            {profileData.supportingTechnicalLine}
          </p>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2 w-full sm:w-auto">
          <a
            href="#projects"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold text-slate-900 bg-sky-400 hover:bg-sky-300 transition shadow-lg shadow-sky-500/20 focus-visible:ring-2 focus-visible:ring-sky-400"
          >
            <span>View Projects</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </a>

          <a
            href={siteConfig.resumePath}
            download={siteConfig.resumeFilename}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold text-slate-200 bg-slate-900/90 hover:bg-slate-800 border border-slate-700/80 hover:border-slate-600 transition shadow-sm focus-visible:ring-2 focus-visible:ring-sky-400"
          >
            <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Download Resume</span>
          </a>
        </div>

        <!-- Social Links Row -->
        <div class="flex items-center gap-4 pt-2 text-slate-400">
          <span class="text-xs uppercase tracking-wider font-mono text-slate-400">Connect:</span>
          
          <a 
            href={siteConfig.social.linkedin} 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="LinkedIn Profile"
            class="flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-lg bg-slate-900 border border-slate-800 hover:border-sky-500/40 hover:text-sky-300 transition"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
            <span>LinkedIn</span>
          </a>

          <a 
            href={siteConfig.social.github} 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="GitHub Profile"
            class="flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-lg bg-slate-900 border border-slate-800 hover:border-sky-500/40 hover:text-sky-300 transition"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
            <span>GitHub</span>
          </a>

          <a 
            href={siteConfig.social.himalayas} 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Himalayas Profile"
            class="flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-lg bg-slate-900 border border-slate-800 hover:border-sky-500/40 hover:text-sky-300 transition"
          >
            <span class="w-4 h-4 rounded bg-slate-800 text-[10px] font-mono font-bold flex items-center justify-center text-sky-400">H</span>
            <span>Himalayas</span>
          </a>
        </div>

      </div>

      <!-- Photo / Visual Column (Col 5/12) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end items-center">
        <ProfilePhoto />
      </div>

    </div>
  </div>
</section>
