---
import { siteConfig } from "../data/config";

const navLinks = [
  { name: "About", href: "#about" },
  { name: "Experience", href: "#experience" },
  { name: "Skills", href: "#skills" },
  { name: "Projects", href: "#projects" },
  { name: "Leadership", href: "#leadership" },
  { name: "Certifications", href: "#certifications" },
  { name: "Education", href: "#education" },
  { name: "Contact", href: "#contact" },
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      
      <!-- Logo / Name -->
      <a href="#home" class="flex items-center gap-3 group focus-visible:ring-2 focus-visible:ring-sky-400 rounded-lg p-1">
        <div class="w-9 h-9 rounded-lg bg-sky-950/80 border border-sky-500/40 flex items-center justify-center text-sky-400 group-hover:border-sky-400 transition shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <div>
          <span class="text-base sm:text-lg font-bold text-slate-100 group-hover:text-sky-300 transition">Irfan Alkan</span>
          <span class="hidden sm:block text-[11px] text-slate-400 tracking-wider uppercase font-mono">SOC & IR</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center space-x-1" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3 py-1.5 text-xs xl:text-sm font-medium text-slate-300 hover:text-sky-300 hover:bg-slate-900/60 rounded-md transition-colors"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Desktop Action & Socials -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- Social Icons -->
        <div class="flex items-center space-x-2 text-slate-400 pr-2 border-r border-slate-800">
          <a 
            href={siteConfig.social.linkedin} 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Irfan Alkan's LinkedIn Profile"
            class="p-1.5 hover:text-sky-400 hover:bg-slate-900 rounded-lg transition"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
          </a>
          <a 
            href={siteConfig.social.github} 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Irfan Alkan's GitHub Profile"
            class="p-1.5 hover:text-sky-400 hover:bg-slate-900 rounded-lg transition"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
          </a>
          <a 
            href={siteConfig.social.himalayas} 
            target="_blank" 
            rel="noopener noreferrer" 
            aria-label="Irfan Alkan's Himalayas Profile"
            class="p-1.5 hover:text-sky-400 hover:bg-slate-900 rounded-lg transition"
            title="Himalayas Profile"
          >
            <span class="text-xs font-bold font-mono tracking-tighter px-1 py-0.5 bg-slate-800 rounded">H</span>
          </a>
        </div>

        <!-- Download Resume Button -->
        <a
          href={siteConfig.resumePath}
          download={siteConfig.resumeFilename}
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-medium text-sky-300 bg-sky-950/60 border border-sky-500/40 rounded-lg hover:bg-sky-900/60 hover:border-sky-400 transition shadow-sm"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Resume</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center lg:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
          class="p-2 rounded-lg text-slate-400 hover:text-slate-100 hover:bg-slate-900 border border-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400"
        >
          <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-slate-800 bg-slate-950/95 backdrop-blur-xl px-4 pt-2 pb-6 space-y-2">
    <div class="flex flex-col space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link px-3 py-2 text-sm font-medium text-slate-300 hover:text-sky-300 hover:bg-slate-900/80 rounded-md transition"
        >
          {link.name}
        </a>
      ))}
    </div>

    <div class="pt-4 border-t border-slate-800/80 flex flex-col gap-3">
      <a
        href={siteConfig.resumePath}
        download={siteConfig.resumeFilename}
        class="flex items-center justify-center gap-2 w-full py-2 text-sm font-medium text-sky-300 bg-sky-950/70 border border-sky-500/50 rounded-lg hover:bg-sky-900/70 transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download Resume (PDF)</span>
      </a>

      <div class="flex items-center justify-center space-x-6 text-slate-400 pt-1">
        <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-sky-400 text-sm font-medium">LinkedIn</a>
        <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" class="hover:text-sky-400 text-sm font-medium">GitHub</a>
        <a href={siteConfig.social.himalayas} target="_blank" rel="noopener noreferrer" class="hover:text-sky-400 text-sm font-medium">Himalayas</a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  function toggleMenu() {
    const isExpanded = btn?.getAttribute("aria-expanded") === "true";
    btn?.setAttribute("aria-expanded", String(!isExpanded));
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
  }

  btn?.addEventListener("click", toggleMenu);

  // Close menu when clicking any nav link
  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (!menu?.classList.contains("hidden")) {
        toggleMenu();
      }
    });
  });
</script>
