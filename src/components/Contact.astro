---
import SectionHeading from "./SectionHeading.astro";
import { siteConfig } from "../data/config";

const isEmailPlaceholder = siteConfig.social.email === "YOUR_EMAIL_HERE";
---

<section id="contact" class="py-16 md:py-24 border-t border-slate-800/80 bg-slate-950/70 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-12">
      <p class="text-xs uppercase font-mono tracking-widest text-sky-400 font-semibold inline-flex items-center gap-2">
        <span class="w-2 h-0.5 bg-sky-400"></span>
        <span>Initiate Contact</span>
        <span class="w-2 h-0.5 bg-sky-400"></span>
      </p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-100 tracking-tight">
        Let's Connect
      </h2>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        I am open to SOC, Security Operations, Incident Response, Detection, and MDR opportunities, with a strong preference for fully remote positions open to candidates based in Türkiye.
      </p>
    </div>

    <!-- Contact Card -->
    <div class="max-w-4xl mx-auto cyber-card rounded-2xl p-6 sm:p-10 border border-slate-800 space-y-8">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        
        <!-- Primary Email CTA -->
        <div class="p-6 rounded-xl bg-slate-900/90 border border-slate-800 flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase text-sky-400 font-semibold">Direct Email</span>
            <p class="text-xs text-slate-400 leading-relaxed">
              Reach out for role inquiries, technical interviews, or team discussions.
            </p>
          </div>

          <div class="pt-4">
            <a
              href={isEmailPlaceholder ? "#" : `mailto:${siteConfig.social.email}`}
              class={`w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition ${
                isEmailPlaceholder
                  ? "bg-slate-800 text-slate-300 border border-slate-700 hover:border-sky-500/40"
                  : "bg-sky-400 hover:bg-sky-300 text-slate-900 shadow-md shadow-sky-500/20"
              }`}
              onclick={isEmailPlaceholder ? "alert('Email address will be updated before publishing. Please connect via LinkedIn or Himalayas in the interim.'); return false;" : ""}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>{isEmailPlaceholder ? "Send Email (Configure in config.ts)" : `Email: ${siteConfig.social.email}`}</span>
            </a>
          </div>
        </div>

        <!-- Download Resume CTA -->
        <div class="p-6 rounded-xl bg-slate-900/90 border border-slate-800 flex flex-col justify-between">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase text-sky-400 font-semibold">Curriculum Vitae</span>
            <p class="text-xs text-slate-400 leading-relaxed">
              Download a comprehensive PDF copy of my technical cybersecurity resume.
            </p>
          </div>

          <div class="pt-4">
            <a
              href={siteConfig.resumePath}
              download={siteConfig.resumeFilename}
              class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold text-slate-200 bg-slate-800/90 hover:bg-slate-700 border border-slate-700 transition"
            >
              <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Download Resume (PDF)</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Professional Profiles Row -->
      <div class="pt-6 border-t border-slate-800/80">
        <span class="text-xs uppercase font-mono tracking-wider text-slate-400 block mb-4 text-center sm:text-left">
          Professional Networks & Code Repositories
        </span>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-lg bg-slate-900/60 border border-slate-800 hover:border-sky-500/40 flex items-center gap-3 transition text-slate-300 hover:text-sky-300"
          >
            <svg class="w-5 h-5 fill-current text-sky-400 shrink-0" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
            <div>
              <span class="text-xs font-semibold block text-slate-200">LinkedIn</span>
              <span class="text-[11px] text-slate-400 font-mono">/in/irfan-alkan</span>
            </div>
          </a>

          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-lg bg-slate-900/60 border border-slate-800 hover:border-sky-500/40 flex items-center gap-3 transition text-slate-300 hover:text-sky-300"
          >
            <svg class="w-5 h-5 fill-current text-slate-300 shrink-0" viewBox="0 0 24 24"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
            <div>
              <span class="text-xs font-semibold block text-slate-200">GitHub</span>
              <span class="text-[11px] text-slate-400 font-mono">@irfanalkan23</span>
            </div>
          </a>

          <a
            href={siteConfig.social.himalayas}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-lg bg-slate-900/60 border border-slate-800 hover:border-sky-500/40 flex items-center gap-3 transition text-slate-300 hover:text-sky-300"
          >
            <span class="w-5 h-5 rounded bg-slate-800 text-xs font-mono font-bold flex items-center justify-center text-sky-400 shrink-0">H</span>
            <div>
              <span class="text-xs font-semibold block text-slate-200">Himalayas</span>
              <span class="text-[11px] text-slate-400 font-mono">@irfanalkan</span>
            </div>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
