---
import { siteConfig } from "../data/config";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800/80 bg-slate-950 py-10 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Copyright & Title -->
      <div class="text-center md:text-left space-y-1">
        <p class="text-sm font-semibold text-slate-300">
          © {currentYear} {siteConfig.name}
        </p>
        <p class="text-xs text-slate-400">
          Cybersecurity | Security Operations | Incident Response
        </p>
      </div>

      <!-- Quick Section Anchor Links -->
      <div class="flex flex-wrap justify-center gap-4 text-xs text-slate-400">
        <a href="#about" class="hover:text-sky-300 transition">About</a>
        <a href="#experience" class="hover:text-sky-300 transition">Experience</a>
        <a href="#skills" class="hover:text-sky-300 transition">Skills</a>
        <a href="#projects" class="hover:text-sky-300 transition">Projects</a>
        <a href="#certifications" class="hover:text-sky-300 transition">Certifications</a>
        <a href="#contact" class="hover:text-sky-300 transition">Contact</a>
      </div>

      <!-- Small Social Links -->
      <div class="flex items-center space-x-4 text-xs">
        <a 
          href={siteConfig.social.linkedin} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-sky-300 transition"
        >
          LinkedIn
        </a>
        <span class="text-slate-700">•</span>
        <a 
          href={siteConfig.social.github} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-sky-300 transition"
        >
          GitHub
        </a>
        <span class="text-slate-700">•</span>
        <a 
          href={siteConfig.social.himalayas} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-sky-300 transition"
        >
          Himalayas
        </a>
      </div>

    </div>
  </div>
</footer>
