---
import SectionHeading from "./SectionHeading.astro";
import { educationData } from "../data/education";
---

<section id="education" class="py-16 md:py-20 border-t border-slate-800/80 bg-slate-900/20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <SectionHeading 
      eyebrow="Academic Background"
      title="Education"
      description="Foundational engineering and graduate analytical education supporting technical rigor and strategic problem-solving."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {educationData.map((edu) => (
        <div class="cyber-card rounded-2xl p-6 sm:p-8 flex flex-col justify-between border border-slate-800">
          <div class="space-y-3">
            <div class="w-10 h-10 rounded-lg bg-sky-950/80 border border-sky-500/40 flex items-center justify-center text-sky-400 mb-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M12 14l9-5-9-5-9 5 9 5z" />
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
              </svg>
            </div>

            <h3 class="text-xl font-bold text-slate-100">
              {edu.degree} in {edu.field}
            </h3>

            <p class="text-sm font-semibold text-sky-400 font-mono">
              {edu.institution}
            </p>

            {edu.description && (
              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed pt-1">
                {edu.description}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
